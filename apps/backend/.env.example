# TruthLens Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Server ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Database (matches docker-compose.yml) ────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://truthlens:truthlens_dev_password@localhost:5432/truthlens

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── LLM (Step 3) ─────────────────────────────────────────────────────────────
# LLM_PROVIDER options: "groq" | "gemini" | "lmstudio" | "ollama"
LLM_PROVIDER=groq

# Groq (recommended for ultra-fast free tier LPU inference): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# Google Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# LM Studio (local server)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=qwen3-8b

# Ollama (local server)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── External APIs (Step 3+) ───────────────────────────────────────────────────
# Google Fact Check Tools API (free): https://developers.google.com/fact-check/tools/api
GOOGLE_FACT_CHECK_API_KEY=your_fact_check_api_key_here
# Google Vision API (free 1k/mo): https://console.cloud.google.com/
GOOGLE_VISION_API_KEY=your_vision_api_key_here
# GDELT: no key needed

# ── Auth (Step 10) ────────────────────────────────────────────────────────────
# Create a free Supabase project at: https://supabase.com/
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here  # Server-side ONLY

# ── Deepfake Provider ────────────────────────────────────────────────────────
# Default: "local" (free HuggingFace model, no key needed)
# Optional paid upgrades: "hive" | "sensity"
DEEPFAKE_PROVIDER=local
HIVE_API_KEY=    # Only needed if DEEPFAKE_PROVIDER=hive
SENSITY_API_KEY= # Only needed if DEEPFAKE_PROVIDER=sensity
