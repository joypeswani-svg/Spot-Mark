{
  "manifest_version": 3,
  "name": "SpotMark",
  "version": "0.2.0",
  "description": "Real-time fake news, deepfake, and AI-image detection for Chrome and Edge.",

  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon-16.png",
      "32":  "icons/icon-32.png",
      "48":  "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "SpotMark — Check this page"
  },

  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/extractor.js", "content/highlighter.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/video-overlay.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "side_panel": {
    "default_path": "side-panel.html"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "sidePanel",
    "alarms",
    "notifications"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://localhost/*",
    "http://localhost:8000/*",
    "http://localhost:8008/*",
    "http://localhost:8010/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:8008/*",
    "http://127.0.0.1:8010/*",
    "http://*/*",
    "https://*/*"
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/*", "fonts/*"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
